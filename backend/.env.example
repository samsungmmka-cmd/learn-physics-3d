# Copy to .env for local development (never commit .env).
PORT=4000
NODE_ENV=development
# Supabase project: Project Settings -> API
SUPABASE_URL=https://hrunahhhuapopjmygben.supabase.co
# The anon / publishable key. Do NOT use the service_role or secret key: the API acts as the
# signed-in user and the database's row-level security decides what each user may do.
SUPABASE_ANON_KEY=
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=https://learn-physics-3d.vercel.app,http://localhost:5173
LOG_LEVEL=info
