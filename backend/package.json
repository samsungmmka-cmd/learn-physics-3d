{
  "name": "learn-physics-api",
  "version": "1.0.0",
  "description": "REST API for Learn Physics Lab: accounts with student/teacher roles, assignments, enrollments, comments and community posts. Supabase (Postgres + Auth) is the database.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
